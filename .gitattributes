# Media lives in Git LFS. Run `git lfs install` once per machine; `git lfs pull` after a clone.
# Videos: everywhere in the repo.
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.m4v filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text
# Raw screenshots (sources of the commercial site's Screenshots page).
screenshots/**/*.png filter=lfs diff=lfs merge=lfs -text
