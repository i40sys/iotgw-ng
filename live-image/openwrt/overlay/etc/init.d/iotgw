#!/bin/sh /etc/rc.common
# iotgw self-healing agent (iotgw-ng decision-032, task-125).
# Keeps the management path working: the Netmaker route on the current LAN
# router, the tunnelled network, and the Internet egress policy
# (/etc/config/iotgw). Logs: logread -e iotgw (or /var/log/messages once
# provisioning installed rsyslog). State: /var/run/iotgw/agent.json.

START=95
STOP=10
USE_PROCD=1
PROG=/usr/sbin/iotgw

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" daemon
	# threshold 3600 s, restart after 5 s, retry forever
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
