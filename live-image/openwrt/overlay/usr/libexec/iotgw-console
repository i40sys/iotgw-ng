#!/bin/sh
# iotgw console (iotgw-ng decision-032): the status dashboard on tty1 and the
# serial console at boot; [q] leaves it for the normal OpenWRT login shell.
# Started by /etc/inittab (respawn), so logging out brings the dashboard back.

# Keep kernel messages off the console from the start (console_loglevel 1 =
# emergencies only): they still reach dmesg/logread, but no longer bury the
# progress below or draw over the dashboard. Restored when leaving.
printk=$(cat /proc/sys/kernel/printk 2>/dev/null)
echo 1 >/proc/sys/kernel/printk 2>/dev/null

# procd starts inittab entries while boot scripts are still running: wait
# until none is (`/etc/rc.common /etc/init.d/<name> boot`), 3 quiet seconds
# in a row, at most 60 s — showing what is still starting, so the wait never
# looks like a hang. (Not the syslog "init complete" marker: logd itself can
# crash during boot and lose it.)
starting() {
	for c in /proc/[0-9]*/cmdline; do
		set -- $(tr '\0' ' ' <"$c" 2>/dev/null)
		[ "$2" = /etc/rc.common ] && [ "$4" = boot ] && echo "${3##*/}"
	done | sort -u | tr '\n' ' '
}
printf '\niotgw: waiting for the system to finish starting before opening the dashboard…\n'
quiet=0 waited=0
while [ "$quiet" -lt 3 ] && [ "$waited" -lt 60 ]; do
	busy=$(starting)
	if [ -n "$busy" ]; then
		quiet=0
		[ $((waited % 3)) -eq 0 ] && printf '  %2ds  still starting: %s\n' "$waited" "$busy"
	else
		quiet=$((quiet + 1))
	fi
	sleep 1
	waited=$((waited + 1))
done
printf '  %2ds  ready — opening the dashboard\n' "$waited"

if [ -x /usr/sbin/iotgw ]; then
	/usr/sbin/iotgw status
fi
[ -n "$printk" ] && echo "$printk" >/proc/sys/kernel/printk 2>/dev/null
exec /usr/libexec/login.sh
