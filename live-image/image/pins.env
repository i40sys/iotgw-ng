# Pinned inputs of the bootable live image (task-149.01). Every download is
# verified against its SHA256 before use; bump a pin = new URL + new hash.

# Upstream Clonezilla live (Debian sid based, kernel 6.6.11-amd64). md5 cross-
# checked against SourceForge's published hash (6ce567c7a626463eda61859ddc0c1743).
CLONEZILLA_VERSION=3.1.2-9
CLONEZILLA_URL=https://downloads.sourceforge.net/project/clonezilla/clonezilla_live_stable/3.1.2-9/clonezilla-live-3.1.2-9-amd64.zip
CLONEZILLA_SHA256=16f21acc9971912d0e3b600ef8689c86de3bb86f5ce48ca37147a88cf3c412f7

# wg / wg-quick for the agent's VPN step (the kernel ships the wireguard
# module). This build needs only libc6 >= 2.14 (the base has 2.37).
WIREGUARD_TOOLS_URL=https://snapshot.debian.org/file/12e689cbddfeb7a866326c13925dfd29cd82948d
WIREGUARD_TOOLS_SHA256=5503a600538e6a6563af19c134edca78e48707d797220e72dc5221a0a9c70a08

# Static curl + CA bundle in the initrd so live-boot can fetch the squashfs
# over HTTPS (busybox wget cannot).
STATIC_CURL_URL=https://github.com/stunnel/static-curl/releases/download/8.22.0/curl-linux-x86_64-musl-8.22.0.tar.xz
STATIC_CURL_SHA256=dfb02460ba2abe513087538f12a3cf79b74b64a5ea3787ce8ac0cdb11251f884
CACERT_URL=https://curl.se/ca/cacert-2026-09-25.pem
CACERT_SHA256=a41b5d356aea97a529fe27e0f7316d2f9d946d75927476cf9cf1b90637d00505
